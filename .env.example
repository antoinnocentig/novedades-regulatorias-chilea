# Vercel KV (Redis) — caché mensual
# Obtener en: vercel.com → Storage → KV
KV_REST_API_URL=https://<tu-kv>.kv.vercel-storage.com
KV_REST_API_TOKEN=<tu-token>

# Secreto para el endpoint cron (llamadas externas)
CRON_SECRET=<secreto-aleatorio>

# URL del sitio
NEXT_PUBLIC_SITE_URL=https://<proyecto>.vercel.app

# ── IA para análisis de PDFs (opcional) ─────────────────────────────────────
# Usado por GET /api/pdf-analytics para extraer métricas del Reporte Mensual CNE
# con Claude (modelo Haiku — el más económico).
# Sin esta variable el endpoint igual funciona, usando extracción por regex.
#
# Obtener API key (con créditos gratuitos iniciales):
#   https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...
