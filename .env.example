# Vercel KV (Redis) — caché mensual
# Obtener en: vercel.com → Storage → KV
KV_REST_API_URL=https://<tu-kv>.kv.vercel-storage.com
KV_REST_API_TOKEN=<tu-token>

# Secreto para el endpoint cron (llamadas externas)
CRON_SECRET=<secreto-aleatorio>

# URL del sitio
NEXT_PUBLIC_SITE_URL=https://<proyecto>.vercel.app

# ============================================================
#  Dashboard Mercado Eléctrico (Python / Streamlit)
# ============================================================
# Conexión a base de datos. Por defecto SQLite (sin configurar).
# Para PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://energia:energia@localhost:5432/energia

# Forzar datos de respaldo sin intentar red (demo/offline):
# OFFLINE_ONLY=false

# Sembrar automáticamente cuando no haya datos en vivo:
# AUTO_SEED=true
